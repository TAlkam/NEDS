    for c in df.columns
    if re.fullmatch(r"i10_dx\d+", c)
]

# Sort numerically:
# i10_dx1, i10_dx2, ..., i10_dx40
dx_cols = sorted(
    dx_cols,
    key=lambda x: int(
        re.search(r"\d+$", x).group()
    )
)

print(

# =============================================================================
# 9. FORMATTING FUNCTIONS
# =============================================================================

def format_percentage(pct):
    """
    Publication-style percentage formatting.
    """

    if pct == 0:
        return "0.0"

    if pct < 0.01:
        return "<0.01"

    if pct < 0.1:
        return "<0.1"

    return f"{pct:.1f}"


def n_pct(data, variable, value):
    """
    Return n (%) using the entire group as the denominator.

    Missing observations therefore remain part of the denominator.
    """

    denominator = len(data)

    if denominator == 0:
        return "0 (0.0)"

    n = int(
        (data[variable] == value).sum()
    )

    pct = (
        100 * n / denominator
    )

    return (
        f"{n:,} "
        f"({format_percentage(pct)})"
    )


def missing_n_pct(data, variable):
    """
    Return missing n (%) using the entire group as denominator.
    """

    denominator = len(data)

    if denominator == 0:
        return "0 (0.0)"

    n = int(
        data[variable]
        .isna()
        .sum()
    )

    pct = (
        100 * n / denominator
    )

    return (
        f"{n:,} "
        f"({format_percentage(pct)})"
    )


def yes_n_pct(data, variable):
    """
    Return n (%) for value = 1 in a binary variable.
    """

    denominator = len(data)

    if denominator == 0:
        return "0 (0.0)"

    n = int(
        (data[variable] == 1).sum()
    )

    pct = (
        100 * n / denominator
    )

    return (
        f"{n:,} "
        f"({format_percentage(pct)})"
    )


def mean_sd(data, variable):
    """
    Return mean ± SD using available observations.
    """

    x = pd.to_numeric(
        data[variable],
        errors="coerce"
    ).dropna()

    if len(x) == 0:
        return "—"

    return (
        f"{x.mean():.1f} ± "
        f"{x.std(ddof=1):.1f}"
    )



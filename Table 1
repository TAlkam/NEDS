    ),
    (
        "75–84",
        df[df["age_group4"] == "75–84"]
    ),
    (
        "≥85",
        df[df["age_group4"] == "≥85"]
    )
]


# =============================================================================
# 9. FORMATTING FUNCTIONS
# =============================================================================

def format_percentage(pct):
    """
    Publication-style percentage formatting.
    """

    if pct == 0:
        return "0.0"

    if pct < 0.01:
        return "<0.01"

    if pct < 0.1:
        return "<0.1"

    return f"{pct:.1f}"


def n_pct(data, variable, value):
    """
    Return n (%) using the entire group as the denominator.

    Missing observations therefore remain part of the denominator.
    """

    denominator = len(data)

    if denominator == 0:
        return "0 (0.0)"

    n = int(
        (data[variable] == value).sum()
    )

    pct = (
        100 * n / denominator
    )

    return (
        f"{n:,} "
        f"({format_percentage(pct)})"
    )


def missing_n_pct(data, variable):
    """
    Return missing n (%) using the entire group as denominator.
    """

    denominator = len(data)

    if denominator == 0:
        return "0 (0.0)"

    n = int(
        data[variable]
        .isna()
        .sum()
    )

    pct = (
        100 * n / denominator
    )

    return (
        f"{n:,} "
        f"({format_percentage(pct)})"
    )


def yes_n_pct(data, variable):
    """
    Return n (%) for value = 1 in a binary variable.
    """

    denominator = len(data)

    if denominator == 0:
        return "0 (0.0)"

    n = int(
        (data[variable] == 1).sum()
    )

    pct = (
        100 * n / denominator
    )

    return (
        f"{n:,} "
        f"({format_percentage(pct)})"
    )


def mean_sd(data, variable):
    """
    Return mean ± SD using available observations.
    """

    x = pd.to_numeric(
        data[variable],
        errors="coerce"
    ).dropna()

    if len(x) == 0:
        return "—"

    return (
        f"{x.mean():.1f} ± "
        f"{x.std(ddof=1):.1f}"
    )


# =============================================================================
# 10. BUILD TABLE 1
# =============================================================================

rows = []


def add_row(
    characteristic,
    category,
    function
):
    """
    Add one row to Table 1.
    """

    row = {
        "Characteristic": characteristic,
        "Category": category
    }

    for group_name, group_data in groups:
        row[group_name] = function(group_data)

    rows.append(row)


# -----------------------------------------------------------------------------
# Study population
# -----------------------------------------------------------------------------

add_row(
    "Study population",
    "ED encounters, n",
    lambda x: f"{len(x):,}"
)


# -----------------------------------------------------------------------------
# Age
# -----------------------------------------------------------------------------

add_row(
    "Age",
    "Mean ± SD, years",
    lambda x: mean_sd(
        x,
        "age"
    )
)

# Missing-age row:
# Missing age applies to the overall cohort only because encounters with
# missing age cannot belong to an age stratum.

age_missing_row = {
    "Characteristic": "Age",
    "Category": "Missing",
    "Overall AD cohort": missing_n_pct(
        df,
        "age"
    ),
    "60–64": "—",
    "65–74": "—",
    "75–84": "—",
    "≥85": "—"
}

rows.append(age_missing_row)


# -----------------------------------------------------------------------------
# Sex
# -----------------------------------------------------------------------------

for value, label in sex_labels.items():

    add_row(
        "Sex",
        label,
        lambda x, v=value: n_pct(
            x,
            "female",
            v
        )
    )

add_row(
    "Sex",
    "Missing",
    lambda x: missing_n_pct(
        x,
        "female"
    )
)


# -----------------------------------------------------------------------------
# Race/ethnicity
# -----------------------------------------------------------------------------

for value, label in race_labels.items():

    add_row(
        "Race/ethnicity",
        label,
        lambda x, v=value: n_pct(
            x,
            "race",
            v
        )
    )

add_row(
    "Race/ethnicity",
    "Missing",
    lambda x: missing_n_pct(
        x,
        "race"
    )
)


# -----------------------------------------------------------------------------
# Primary payer
# -----------------------------------------------------------------------------

for value, label in payer_labels.items():

    add_row(
        "Primary payer",
        label,
        lambda x, v=value: n_pct(
            x,
            "pay1",
            v
        )
    )

add_row(
    "Primary payer",
    "Missing",
    lambda x: missing_n_pct(
        x,
        "pay1"
    )
)


# -----------------------------------------------------------------------------

        x,
        "zipinc_qrtl"
    )
)


# -----------------------------------------------------------------------------
# Patient residence
# -----------------------------------------------------------------------------

for value, label in residence_labels.items():

    add_row(
        "Patient residence",
        label,
        lambda x, v=value: n_pct(
            x,
            "pl_nchs",
            v
        )
    )

add_row(
    "Patient residence",
    "Missing",
    lambda x: missing_n_pct(
        x,

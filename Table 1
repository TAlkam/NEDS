# =============================================================================
# TABLE 1
# Demographic and socioeconomic characteristics of Alzheimer’s disease
# emergency department encounters by age group, NEDS 2022
#
# Study file:
# NEDS_2022_Core Alzheimers only.dta
#
# Notes:
# - Overall analytic cohort: N = 125,461 AD-associated ED encounters
# - Age is missing for 8 encounters.
# - These 8 encounters remain in the overall cohort but are not assigned
#   to an age stratum.
# - Categorical percentages use the TOTAL number of encounters in each
#   column as the denominator, including missing observations.
# - Homelessness is identified from ICD-10-CM Z59.0x diagnosis codes.
# =============================================================================

import os
import re
import numpy as np
import pandas as pd
from IPython.display import display


# =============================================================================
# 1. LOAD DATA
# =============================================================================

file_path = "/content/NEDS_2022_Core Alzheimers only.dta"

# Optional upload step for Google Colab
if not os.path.exists(file_path):
    from google.colab import files

    print("Please upload: NEDS_2022_Core Alzheimers only.dta")
    uploaded = files.upload()

    dta_files = [
        filename
        for filename in uploaded.keys()
        if filename.lower().endswith(".dta")
    ]

    if len(dta_files) == 0:
        raise FileNotFoundError("No Stata .dta file was uploaded.")

    file_path = "/content/" + dta_files[0]


print("Loading:", file_path)

df = pd.read_stata(
    file_path,
    convert_categoricals=False
)

# Standardize variable names
df.columns = [c.lower() for c in df.columns]

print(f"Dataset loaded: {df.shape[0]:,} ED encounters")
print(f"Number of variables: {df.shape[1]:,}")


# =============================================================================
# 2. VERIFY REQUIRED VARIABLES
# =============================================================================

required_variables = [
    "age",
    "female",
    "race",
    "pay1",
    "zipinc_qrtl",
    "pl_nchs"
]

missing_variables = [
    variable
    for variable in required_variables
    if variable not in df.columns
]

if missing_variables:
    raise KeyError(
        f"Required variables not found: {missing_variables}"
    )

print("\nRequired demographic variables confirmed.")


# =============================================================================
# 3. CREATE AGE GROUPS
# =============================================================================
#
# Eight encounters have missing age.
# They are retained in the overall cohort but will have age_group4 = missing.
#
# Age groups used in the manuscript:
# 60–64
# 65–74
# 75–84
# ≥85
# =============================================================================

df["age_group4"] = pd.cut(
    df["age"],
    bins=[59, 64, 74, 84, np.inf],
    labels=[
        "60–64",
        "65–74",
        "75–84",
        "≥85"
    ],
    right=True
)

print("\nAge-group distribution:")
print(
    df["age_group4"]
    .value_counts(sort=False, dropna=False)
)

print(
    f"\nMissing age: "
    f"{df['age'].isna().sum():,}"
)


# =============================================================================
# 4. VERIFY AGE-GROUP COUNTS
# =============================================================================

expected_age_counts = {
    "60–64": 2784,
    "65–74": 18512,
    "75–84": 51440,
    "≥85": 52717
}

actual_age_counts = (
    df["age_group4"]
    .value_counts(sort=False)
    .to_dict()
)

print("\nAge-group count verification:")

for group, expected in expected_age_counts.items():
    actual = int(actual_age_counts.get(group, 0))

    print(
        f"{group}: "
        f"actual = {actual:,}, "
        f"expected = {expected:,}"
    )

print(
    "\nEncounters assigned to an age group:",
    f"{df['age_group4'].notna().sum():,}"
)

print(
    "Overall cohort:",
    f"{len(df):,}"
)


# =============================================================================
# 5. IDENTIFY ICD-10-CM DIAGNOSIS VARIABLES
# =============================================================================

dx_cols = [
    c
    for c in df.columns
    if re.fullmatch(r"i10_dx\d+", c)
]

# Sort numerically:
# i10_dx1, i10_dx2, ..., i10_dx40
dx_cols = sorted(
    dx_cols,
    key=lambda x: int(
        re.search(r"\d+$", x).group()
    )
)

print(
    f"\nNumber of diagnosis fields detected: "
    f"{len(dx_cols)}"
)

if dx_cols:
    print(
        "Diagnosis fields:",
        dx_cols[0],
        "through",
        dx_cols[-1]
    )


# =============================================================================
# 6. DERIVE DOCUMENTED HOMELESSNESS
# =============================================================================
#
# 2022 ICD-10-CM homelessness codes include:
#
# Z59.00  Homelessness unspecified
# Z59.01  Sheltered homelessness
# Z59.02  Unsheltered homelessness
#
# HCUP diagnosis codes are commonly stored without decimal points:
#
# Z5900
# Z5901
# Z5902
#
# We therefore identify any diagnosis beginning with Z590.
# =============================================================================

homeless = pd.Series(
    False,
    index=df.index
)

for col in dx_cols:

    cleaned_dx = (
        df[col]
        .fillna("")
        .astype(str)
        .str.upper()
        .str.strip()
        .str.replace(".", "", regex=False)
    )

    homeless = (
        homeless |
        cleaned_dx.str.startswith("Z590")
    )

df["homeless"] = homeless.astype(int)

n_homeless = int(df["homeless"].sum())
pct_homeless = (
    100 * n_homeless / len(df)
)

print("\nDocumented homelessness:")
print(f"n = {n_homeless:,}")
print(f"Percent = {pct_homeless:.3f}%")


# =============================================================================
# 7. CATEGORY LABELS
# =============================================================================
#
# HCUP RACE is a combined race/ethnicity variable.
# =============================================================================

sex_labels = {
    0: "Male",
    1: "Female"
}

race_labels = {
    1: "White",
    2: "Black",
    3: "Hispanic",
    4: "Asian/Pacific Islander",
    5: "Native American",
    6: "Other"
}

payer_labels = {
    1: "Medicare",
    2: "Medicaid",
    3: "Private insurance",
    4: "Self-pay",
    5: "No charge",
    6: "Other"
}

income_labels = {
    1: "Quartile 1 (lowest)",
    2: "Quartile 2",
    3: "Quartile 3",
    4: "Quartile 4 (highest)"
}

residence_labels = {
    1: "Large central metropolitan",
    2: "Large fringe metropolitan",
    3: "Medium metropolitan",
    4: "Small metropolitan",
    5: "Micropolitan",
    6: "Noncore"
}


# =============================================================================
# 8. DEFINE TABLE COLUMNS
# =============================================================================

groups = [
    (
        "Overall AD cohort",
        df
    ),
    (
        "60–64",
        df[df["age_group4"] == "60–64"]
    ),
    (
        "65–74",
